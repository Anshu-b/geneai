# Copy to .env. Never commit .env. Scripts call load_dotenv().

# veri.studio OpenAI-compatible deployment.
# Base URL is https://api.veri.studio/v1/deployments/bfe84d51e141
# The OpenAI SDK appends /chat/completions. Do not put that suffix here.
# Verified externally (create 201). Not secrets.
# OpenAI model field is the deployment name, not the Hugging Face repo.
# HF: Qwen/Qwen2.5-7B-Instruct on vLLM, 1x L4-24GB.
# concurrency_target 8. About $1.05/hr (GPU time, not a per-token price).
VERI_API_KEY=
VERI_DEPLOYMENT_ID=bfe84d51e141
VERI_MODEL=geneai-qwen7b
# VERI_WAKE_TIMEOUT_SECONDS=180
# VERI_CONCURRENCY=8
# Per-call timeout. The L4 generates about 16 tokens/s, so 30s is too short.
# VERI_TIMEOUT_SECONDS=120

# CREAO app-scoped API Trigger. Key prefix capi_. Not a cr_sk_ CLI key.
# App id is the GeneAI Mutator (not a secret).
CREAO_API_KEY=
CREAO_APP_ID=0ed64fee-5003-4d56-a83b-c5f369d7a39c
# CREAO_TIMEOUT_SECONDS=180
# CREAO_POLL_SECONDS=2
# CREAO_WEBHOOK_URL=

# One-shot arm. All three are required or the arm is skipped.
# gpt-5.5 uses the OpenAI Responses API (max_output_tokens, store=false, no temperature).
# Other models use Chat Completions with max_completion_tokens.
# The key stays empty. Base URL and model are the verified OpenAI settings.
FRONTIER_API_KEY=
FRONTIER_BASE_URL=https://api.openai.com/v1
FRONTIER_MODEL=gpt-5.5

# Browser Use Cloud API v2 tasks, live shopping only.
# Header X-Browser-Use-API-Key (not Bearer). Verified on GET /api/v2/billing/account.
# POST /api/v2/tasks, poll /api/v2/tasks/{id}/status, then GET /api/v2/tasks/{id}.
# structuredOutput is a stringified JSON schema. Also pass --catalog-url.
# A successful collection is cached at data/catalogs/shopping_recorded.json (source recorded).
# Documented key prefix bu_. The task text asks for a multi-category retailer.
# A live catalog task is often about 5 minutes. BROWSER_USE_TIMEOUT_SECONDS defaults to 420.
BROWSER_USE_API_KEY=
# BROWSER_USE_TIMEOUT_SECONDS=420

# Unused. This account's capi_ key is rejected by developer.creao.ai/v1.
# CREAO_AGENT_ID=
# CREAO_ALLOW_UNVERIFIED_CLI=
