# Copy to .env. Never commit .env. Scripts call load_dotenv().

# veri.studio OpenAI-compatible deployment.
# Base URL is https://api.veri.studio/v1/deployments/$VERI_DEPLOYMENT_ID
# The OpenAI SDK appends /chat/completions. Do not put that suffix here.
VERI_API_KEY=
VERI_DEPLOYMENT_ID=
VERI_MODEL=

# CREAO app-scoped API Trigger. Key prefix capi_. Not a cr_sk_ CLI key.
# App id is the GeneAI Mutator (not a secret).
CREAO_API_KEY=
CREAO_APP_ID=0ed64fee-5003-4d56-a83b-c5f369d7a39c
# CREAO_TIMEOUT_SECONDS=180
# CREAO_POLL_SECONDS=2
# CREAO_WEBHOOK_URL=

# Optional later one-shot baseline. Unused by the Phase 1 evolutionary loop.
# FRONTIER_BASE_URL must be a real OpenAI-compatible base URL you control.
FRONTIER_API_KEY=
FRONTIER_BASE_URL=
FRONTIER_MODEL=

# Unused. This account's capi_ key is rejected by developer.creao.ai/v1.
# CREAO_AGENT_ID=
# CREAO_ALLOW_UNVERIFIED_CLI=
